# MARVEL: Omniverse Auctions - Environment Configuration

# Server Port
PORT=4000

# Client Application URL
CLIENT_URL=http://localhost:5173

# Optional: Supabase Database and Auth Credentials
# (The application runs with built-in in-memory / persistent engine fallback if Supabase is not configured)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
